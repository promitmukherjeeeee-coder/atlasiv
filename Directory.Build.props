<Project>
  <!-- Shared build settings for every project. See docs/decisions-log.md, ENG-002 and ENG-003. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Deterministic build: same source gives the same binaries. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Hard rule 2: integer overflow throws, never wraps. Code that must wrap
         (for example a hash mixer) says so explicitly with `unchecked`. -->
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>

    <!-- Every warning is a build error. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- No culture-specific formatting or parsing anywhere. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Hard rule 3: no System.Random or other unseeded randomness in any project. Using a symbol
       listed in BannedSymbols.txt is warning RS0030, which fails the build. See ENG-008. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>

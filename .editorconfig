root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_style = space
indent_size = 2

# Test names read as sentences, so underscores are allowed there.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# BenchmarkDotNet requires benchmark methods to be instance methods.
[bench/**.cs]
dotnet_diagnostic.CA1822.severity = none
